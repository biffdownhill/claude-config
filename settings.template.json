{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 2
  },
  "agent": "triage-orchestrator",
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true
}
